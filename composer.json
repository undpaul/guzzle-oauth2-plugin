{
    "name": "undpaul/guzzle-oauth2-plugin",
    "description": "An OAuth2 middleware for Guzzle based on commerceguys/guzzle-oauth2-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.10",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Sainsburys\\Guzzle\\Oauth2\\": "src"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Sainsburys\\Guzzle\\Oauth2\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Bojan Zivanovic"
        },
        {
            "name": "Damien Tournoud"
        },
        {
            "name": "Patrick Dawkins"
        },
        {
            "name": "Daniel Macedo"
        }
    ]
}
